# Production backend environment template for EC2 Docker Compose.
# Copy the filled content into the GitHub Actions secret named BACKEND_ENV_FILE.
# Do not commit real secret values.

BACKEND_DOMAIN=api.example.com

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?connection_limit=1&pool_timeout=20
IDENTITY_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?connection_limit=1&pool_timeout=20&schema=identity
PROPERTY_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?connection_limit=1&pool_timeout=20&schema=property
RENTAL_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?connection_limit=1&pool_timeout=20&schema=rental
COMMUNITY_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?connection_limit=1&pool_timeout=20&schema=community
PREFERENCE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?connection_limit=1&pool_timeout=20&schema=preference
AI_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

JWT_SECRET=replace-with-long-random-secret
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters

RABBITMQ_USER=coliving_prod
RABBITMQ_PASSWORD=replace-with-strong-rabbitmq-password
RABBITMQ_EXCHANGE=coliving.events
RABBITMQ_DEAD_LETTER_EXCHANGE=coliving.events.dlx
OUTBOX_POLL_INTERVAL_MS=1000

USE_SERVICE_SCHEMAS=true
AI_USE_PROJECTIONS=true
EVENT_CONSUMER_MAX_RETRIES=5
AI_PROJECTION_QUEUE=ai-service.projections
AI_RECONCILIATION_INTERVAL_SECONDS=86400
AI_RECONCILIATION_RUN_ON_START=false
AI_ENABLE_RECONCILIATION_SCHEDULER=false
AI_RECONCILE_ROOM_PROFILES=false
AI_PROVISION_SCHEMA=false

MICROSERVICE_TIMEOUT_MS=8000
IDENTITY_SERVICE_TIMEOUT_MS=8000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
MAIL_FROM=
PASSWORD_RESET_DEV_MODE=false
PASSWORD_RESET_PEPPER=replace-with-independent-random-secret

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password
